---
http:
  routers:
    adguard:
      entryPoints:
        - https
      rule: Host(`dns.{{ root_domain }}`)
      middlewares:
        - chain-internal
      tls: {}
      service: adguard
    home-assistant:
      entryPoints:
        - https
      rule: Host(`ha.{{ root_domain }}`)
      middlewares:
        - chain-internal
      tls: {}
      service: home-assistant
  services:
    adguard:
      loadBalancer:
        servers:
          - url: http://host.docker.internal:8080
        passHostHeader: true
    home-assistant:
      loadBalancer:
        servers:
          - url: http://host.docker.internal:8123
        passHostHeader: true
  middlewares:
    compress:
      compress: {}
    default-headers:
      headers:
        customBrowserXSSValue: "0"
        contentTypeNosniff: true
        stsSeconds: 31536000
        forceSTSHeader: true
        stsIncludeSubdomains: true
        stsPreload: true
        customFrameOptionsValue: SAMEORIGIN
        customRequestHeaders:
          X-Forwarded-Proto: https
        referrerPolicy: "no-referrer"
        permissionsPolicy: "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), magnetometer=(), gyroscope=(), accelerometer=(), midi=(), sync-xhr=(), display-capture=(), screen-wake-lock=(), xr-spatial-tracking=(), interest-cohort=(), browsing-topics=(), fullscreen=(self), autoplay=(self), picture-in-picture=(self)"
        contentSecurityPolicyReportOnly: "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss: https:; frame-src 'self'; frame-ancestors 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
        customResponseHeaders:
          X-Robots-Tag: "none,noarchive,nosnippet,notranslate,noimageindex"
          X-Permitted-Cross-Domain-Policies: "none"
          X-DNS-Prefetch-Control: "off"
          Cross-Origin-Resource-Policy: "same-site"
          Cross-Origin-Opener-Policy: "same-origin-allow-popups"
    rate-limit:
      rateLimit:
        average: 100
        burst: 50
    local-ipwhitelist:
      ipAllowList:
        sourceRange:
          - "127.0.0.1/32" # Localhost
          - "{{ local_subnet }}"
          - "172.16.0.0/12" # Docker internal network
          - "100.64.0.0/10" # Tailnet (headscale prefixes.v4)
          - "fd7a:115c:a1e0::/48" # Tailnet (headscale prefixes.v6)
    chain-internal:
      chain:
        middlewares:
          - compress
          - default-headers
          - rate-limit
          - local-ipwhitelist
    chain-public:
      chain:
        middlewares:
          - compress
          - default-headers
          - rate-limit
tls:
  options:
    default:
      minVersion: VersionTLS13 # TLS 1.3 only; cipherSuites is ignored by Go's crypto/tls for 1.3 (fixed AEAD suites)
      curvePreferences:
        - X25519MLKEM768 # post-quantum hybrid (ML-KEM768 + X25519), used when the client supports it
        - X25519
        - CurveP384
        - CurveP256
      sniStrict: true
